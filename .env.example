# OpenAI-compatible API settings for AI table name generation
# Copy this file to .env and fill in your values

# API key (required) — works with OpenAI, Groq, Together, Azure, etc.
VITE_OPENAI_API_KEY=

# Base URL (optional) — leave blank for OpenAI, set for other providers
# Examples:
#   Groq:     https://api.groq.com/openai/v1
#   Together: https://api.together.xyz/v1
#   Ollama:   http://localhost:11434/v1
#   Azure:    https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
VITE_OPENAI_BASE_URL=

# Model name (optional, defaults to gpt-4o-mini)
# Examples: gpt-4o, gpt-4o-mini, llama-3.1-70b, claude-sonnet-4-5-20250929
VITE_OPENAI_MODEL=
